# Copy to .env. With no key the app runs in offline demo mode.
# OPENAI_API_KEY=your-key-here
# LLM_PROVIDER=openai     
# EMBEDDING_PROVIDER=openai 
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=               # any OpenAI-compatible server, e.g. OpenRouter or local Ollama
